diff --git a/ext/gpu_jacobian_cuda.jl b/ext/gpu_jacobian_cuda.jl
index b2b3e0c9..ae1c505f 100644
--- a/ext/gpu_jacobian_cuda.jl
+++ b/ext/gpu_jacobian_cuda.jl
@@ -5 +5 @@
-struct CUDAJacobianProducts{P}
+struct CUDAJacobianProducts{P,V,I}
@@ -6,0 +7,2 @@ struct CUDAJacobianProducts{P}
+    pivot::V
+    info::I
@@ -13 +15,29 @@ function CoreRT.make_jacobian_products(A::CuArray{FT,3,CUDA.DeviceMemory}, np) w
-    CUDAJacobianProducts(Dict{NTuple{5,UInt},Tuple{Any,P}}())
+    CUDAJacobianProducts(Dict{NTuple{5,UInt},Tuple{Any,P}}(),
+        CuArray{Cint}(undef,size(A,1),size(A,3)),CuArray{Cint}(undef,size(A,3)))
+end
+
+# As in the forward pointer-based inverse, LU and inverse construction share
+# one CUDA stream. The plan owns pivots/info as well as matrix pointers, so
+# different solves never share mutable factorization scratch.
+for (FT,factor,invert) in ((Float64,:cublasDgetrfBatched,:cublasDgetriBatched),
+                           (Float32,:cublasSgetrfBatched,:cublasSgetriBatched))
+    @eval function _vendor_jacobian_inverse!(cache,G::AbstractArray{$FT},A)
+        n,ns=size(G,1),size(G,3)
+        Ap=_jacobian_pointers!(cache,A,ns,1)
+        Gp=_jacobian_pointers!(cache,G,ns,1)
+        CUDA.CUBLAS.$factor(CUDA.CUBLAS.handle(),n,Ap,n,cache.pivot,cache.info,ns)
+        CUDA.CUBLAS.$invert(CUDA.CUBLAS.handle(),n,Ap,n,cache.pivot,Gp,n,cache.info,ns)
+        return G
+    end
+end
+
+function CoreRT._jacobian_inverse_with_plan!(cache::CUDAJacobianProducts,G,tmp,A,B,I_static)
+    n,ns=size(G,1),size(G,3)
+    compatible = ndims(G)==3 && size(cache.pivot)==(n,ns) &&
+        size(G)==size(tmp)==size(A)==size(B) &&
+        stride(G,1)==stride(tmp,1)==1 && stride(G,2)==stride(tmp,2)==n
+    (CoreRT._CACHED_JACOBIAN_INVERSE_ENABLED[] && compatible) ||
+        return CoreRT._jacobian_geometric_inverse!(G,tmp,A,B,I_static)
+    CoreRT._bmm!(tmp,A,B)
+    tmp .= I_static .- tmp
+    return _vendor_jacobian_inverse!(cache,G,tmp)
@@ -84 +114 @@ function Base.deepcopy_internal(cache::CUDAJacobianProducts, stack::IdDict)
-    copy = CUDAJacobianProducts(empty(cache.pointers))
+    copy = CUDAJacobianProducts(empty(cache.pointers),similar(cache.pivot),similar(cache.info))
