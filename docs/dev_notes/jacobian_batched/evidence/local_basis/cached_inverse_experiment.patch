diff --git a/test/test_jacobian_vendor.jl b/test/test_jacobian_vendor.jl
index 7bd2423f..4941044b 100644
--- a/test/test_jacobian_vendor.jl
+++ b/test/test_jacobian_vendor.jl
@@ -1 +1 @@
-using Test, Random, vSmartMOM
+using Test, Random, LinearAlgebra, vSmartMOM
@@ -46,0 +47,19 @@ if get(ENV,"VSMARTMOM_JACOBIAN_GPU_TEST","false") == "true"
+        # Reuse the same LU buffers over changing matrices; check the defining
+        # inverse identity against an independent host solve, including a copied
+        # plan. This catches stale pointer/pivot reuse across successive calls.
+        inverse_flag=C._CACHED_JACOBIAN_INVERSE_ENABLED[]
+        try
+            C._CACHED_JACOBIAN_INVERSE_ENABLED[]=true
+            ident=CuArray(Matrix{FT}(I,n,n))
+            for cache in (w.products,copy), scale in (FT(0.01),FT(0.03))
+                left,right=A.*scale,B.*scale
+                C._jacobian_inverse_with_plan!(cache,w.G,w.m1,left,right,ident)
+                hG,hA,hB=Array(w.G),Array(left),Array(right)
+                @test all(s->isapprox(hG[:,:,s],inv(I-hA[:,:,s]*hB[:,:,s]);
+                    rtol=300eps(FT),atol=300eps(FT)),1:ns)
+            end
+            @test pointer(copy.pivot) != pointer(w.products.pivot)
+            @test pointer(copy.info) != pointer(w.products.info)
+        finally
+            C._CACHED_JACOBIAN_INVERSE_ENABLED[]=inverse_flag
+        end
