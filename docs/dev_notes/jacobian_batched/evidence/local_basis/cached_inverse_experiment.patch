+the workspace owns their lifetime.
@@ -225,0 +228,5 @@ end
+@inline _jacobian_geometric_inverse!(w::JacobianPropagationWorkspace,R₁,R₂,I_static) =
+    _jacobian_inverse_with_plan!(w.products,w.G,w.m1,R₁,R₂,I_static)
+_jacobian_inverse_with_plan!(::Nothing,G,tmp,R₁,R₂,I_static) =
+    _jacobian_geometric_inverse!(G,tmp,R₁,R₂,I_static)
+
@@ -263 +270 @@ function doubling_batched_lin!(pol_type, expk, ndoubl, a, da, I_static, dτ, μ
-        _jacobian_geometric_inverse!(w.G, w.m1, r, r, I_static)
+        _jacobian_geometric_inverse!(w, r, r, I_static)
@@ -337 +344 @@ function _interaction_direction_lin!(w, R, dR, Rout, dRout, Tleft, dTleft,
-    _jacobian_geometric_inverse!(w.G, w.m1, R, Rout, I_static)
+    _jacobian_geometric_inverse!(w, R, Rout, I_static)
